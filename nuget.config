<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Use nuget.org as the primary source.
      The sandbox build used a local source (/tmp/nuget-local) that does not
      exist outside the CI container — that entry has been removed.
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    No packageSourceMapping section: all packages resolve from nuget.org.
    If you need an additional corporate/private feed, add it here and use
    packageSourceMapping to control which packages come from which source.
  -->
</configuration>
