# Line endings are decided here, not by each developer's core.autocrlf.
#
# WHY THIS FILE EXISTS
# ────────────────────
# This repo is edited on Windows and built by CI on ubuntu-latest (see
# .github/workflows/ci.yml). Windows git defaults to core.autocrlf=true, which
# rewrites every checked-out file to CRLF while storing LF. Without the rules
# below, the first commit from a Linux machine — or any tool that rewrites a
# file wholesale — produces a diff touching every line of every file, and the
# real change is invisible inside it.
#
# `* text=auto` normalises to LF in the repository for anything git detects as
# text, regardless of the committer's platform. Working-copy endings stay
# native unless a rule below pins them.

* text=auto

# ── Source and config: LF in the repo and in the working copy ────────────────
# The Python gates (scripts/check-*.py) are run by CI on Linux and by hand on
# Windows; pinning them to LF keeps one file from behaving differently in the
# two places. The .NET toolchain is line-ending agnostic, so LF is safe for C#
# and project files too.
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.xaml      text eol=lf
*.manifest  text eol=lf
*.appxmanifest text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.runsettings text eol=lf
*.config    text eol=lf

# ── Windows-only files that genuinely want CRLF ──────────────────────────────
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ── Binary: never touch, never diff as text ──────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.pdf       binary
*.zip       binary
*.snk       binary
*.pfx       binary

# ── Generated snapshots ──────────────────────────────────────────────────────
# api/*.api.txt is regenerated by PublicApiSurfaceTests with TABLETOP_UPDATE_API=1
# and reviewed as a diff — it is the record of the public surface, so it must be
# a clean line-by-line diff and never a whole-file rewrite.
api/*.api.txt text eol=lf
