<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Real test project — no longer an Exe with a custom runner -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TableTop.Core\TableTop.Core.csproj" />
    <ProjectReference Include="..\..\src\TableTop.Games\TableTop.Games.csproj" />
    <ProjectReference Include="..\..\src\TableTop.Hosting\TableTop.Hosting.csproj" />
    <!-- Plain net10.0, no MAUI/WinUI SDK needed — this is exactly why the
         shared ViewModels can be unit-tested here at all. -->
    <ProjectReference Include="..\..\src\TableTop.Presentation\TableTop.Presentation.csproj" />
  </ItemGroup>
</Project>
