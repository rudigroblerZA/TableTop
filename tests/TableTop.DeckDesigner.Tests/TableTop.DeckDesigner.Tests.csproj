<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deliberately not tests/TableTop.Tests: that project's four engine
         references are the documented invariant that keeps it cross-platform
         (see CLAUDE.md). This tool-support library isn't one of the four
         engine assemblies, so it gets its own test project instead of a fifth
         reference blurring that line. -->
    <ProjectReference Include="..\..\tools\TableTop.DeckDesigner.Core\TableTop.DeckDesigner.Core.csproj" />
  </ItemGroup>
</Project>
