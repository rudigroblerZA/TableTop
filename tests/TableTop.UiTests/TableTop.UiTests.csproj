<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Targets WinUI's framework because these tests reference TableTop.WinUI.
      They used to reference TableTop.Wpf; WPF was removed, and the tests are
      reflection-driven and head-agnostic by design, so repointing them was a
      change of assembly rather than a rewrite.

      This confines the project to the Windows CI job, which is where the WinUI
      build already runs. TableTop.Tests stays cross-platform: only the UI layer
      pays the Windows cost.
    -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Without this, the test host can't start at all: it throws
      System.IO.FileNotFoundException on Microsoft.TestPlatform.CoreUtilities
      before a single test runs. That assembly ships in
      Microsoft.TestPlatform.ObjectModel's lib/net8.0 folder — a plain
      compile+runtime asset, nothing RID-specific — but with
      RuntimeIdentifiers set (needed for UseWinUI) the SDK stops copying
      framework-dependent package assets to the build output on the
      assumption a publish step will resolve them via the RID graph, and
      `dotnet test` never publishes. TableTop.Tests (no RuntimeIdentifiers,
      no UseWinUI) never hits this; this project is the only one that needs
      the override.
    -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ui\TableTop.WinUI\TableTop.WinUI.csproj" />
  </ItemGroup>
</Project>
