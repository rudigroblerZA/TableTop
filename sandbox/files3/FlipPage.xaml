<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FactOrFiction.FlipPage"
             BackgroundColor="#1A1A19"
             Shell.NavBarIsVisible="False">

    <!--
        Fonts (register in MauiProgram.CreateMauiApp):
            fonts.AddFont("Anton-Regular.ttf", "Anton");
            fonts.AddFont("BarlowCondensed-Regular.ttf", "Condensed");
            fonts.AddFont("BarlowCondensed-Medium.ttf", "CondensedMedium");
            fonts.AddFont("tabler-icons.ttf", "Tabler");

        There is no backface-visibility or preserve-3d in MAUI, so the flip is faked:
        rotate the card to 90 degrees, swap which face is visible, rotate back from -90.
        Both faces live in the same Grid cell inside FlipCard.
    -->

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Ink">#F1EFE8</Color>
            <Color x:Key="Muted">#888780</Color>
            <Color x:Key="Slab">#2C2C2A</Color>
            <Color x:Key="FactFill">#3C3489</Color>
            <Color x:Key="FactInk">#EEEDFE</Color>
            <Color x:Key="FictionFill">#993C1D</Color>
            <Color x:Key="FictionInk">#FAECE7</Color>
            <Color x:Key="RightFill">#27500A</Color>
            <Color x:Key="RightInk">#C0DD97</Color>
            <Color x:Key="WrongFill">#501313</Color>
            <Color x:Key="WrongInk">#F09595</Color>

            <Style x:Key="Display" TargetType="Label">
                <Setter Property="FontFamily" Value="Anton" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
            </Style>

            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontFamily" Value="Condensed" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CharacterSpacing" Value="2" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid Padding="16,10,16,20" RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="4,0" Margin="0,0,0,14">
            <Label Grid.Column="0" Text="&#xeb55;" FontFamily="Tabler" FontSize="20"
                   TextColor="#B4B2A9" VerticalOptions="Center" />
            <Label Grid.Column="1" x:Name="ProgressLabel" Style="{StaticResource Eyebrow}"
                   Text="card 1 of 5" HorizontalOptions="Center" VerticalOptions="Center" />
            <Label Grid.Column="2" x:Name="StreakLabel" Text="0 streak" FontFamily="Condensed"
                   FontSize="16" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
        </Grid>

        <Border Grid.Row="1" x:Name="FlipCard" StrokeThickness="0" Padding="24"
                BackgroundColor="{StaticResource Slab}"
                StrokeShape="RoundRectangle 20"
                MinimumHeightRequest="300" Margin="0,0,0,14"
                AnchorX="0.5" AnchorY="0.5">
            <Grid>

                <VerticalStackLayout x:Name="FrontFace" Spacing="16" VerticalOptions="Center">
                    <Label Style="{StaticResource Eyebrow}" Text="true or made up?" />
                    <Label x:Name="ClaimLabel" FontFamily="CondensedMedium" FontSize="30"
                           LineHeight="1.15" TextColor="{StaticResource Ink}"
                           Text="Bananas are berries, but strawberries are not." />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="BackFace" Spacing="12" IsVisible="False"
                                     VerticalOptions="Start">
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" x:Name="VerdictIcon" FontFamily="Tabler"
                               FontSize="22" Text="&#xea5e;" TextColor="{StaticResource RightInk}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" x:Name="VerdictLabel" Style="{StaticResource Display}"
                               FontSize="26" Text="Right" TextColor="{StaticResource RightInk}" />
                    </Grid>
                    <Label x:Name="AnswerLabel" Style="{StaticResource Display}" FontSize="34"
                           Text="Fact" />
                    <Label x:Name="WhyLabel" FontFamily="Condensed" FontSize="19" LineHeight="1.3"
                           TextColor="#B4B2A9"
                           Text="Botanically a banana is a berry." />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <Grid Grid.Row="2">

            <Grid x:Name="Choices" ColumnDefinitions="*,*" ColumnSpacing="8">
                <Border Grid.Column="0" StrokeThickness="0" Padding="0,16"
                        BackgroundColor="{StaticResource FactFill}"
                        StrokeShape="RoundRectangle 14,2,14,2">
                    <Label Style="{StaticResource Display}" Text="Fact" FontSize="24"
                           TextColor="{StaticResource FactInk}" HorizontalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFact" />
                    </Border.GestureRecognizers>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" Padding="0,16"
                        BackgroundColor="{StaticResource FictionFill}"
                        StrokeShape="RoundRectangle 2,14,2,14">
                    <Label Style="{StaticResource Display}" Text="Fiction" FontSize="24"
                           TextColor="{StaticResource FictionInk}" HorizontalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFiction" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <Border x:Name="NextButton" IsVisible="False" StrokeThickness="0" Padding="0,16"
                    BackgroundColor="{StaticResource Ink}"
                    StrokeShape="RoundRectangle 14">
                <Label Style="{StaticResource Display}" Text="Next card" FontSize="24"
                       TextColor="#1A1A19" HorizontalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNext" />
                </Border.GestureRecognizers>
            </Border>

        </Grid>
    </Grid>
</ContentPage>
