<?xml version="1.0" encoding="utf-8"?>
<!--
    Brass-bordered walnut button, rounded to match the card panel. Pressed
    inverts to a solid brass fill (a coin flip); D-pad focus (Android TV, or a
    hardware keyboard) gets the same brass fill with a thicker parchment ring,
    since a TV remote has no cursor and the platform draws no highlight of its
    own on a custom background. Disabled dims both colours rather than relying
    on the platform's default disabled tint, since the solid/stroke colours
    here are explicit and wouldn't otherwise dim at all.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/walnut_dim" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/brass_dim" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brass" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/brass" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brass" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/parchment" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/walnut" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/brass" />
        </shape>
    </item>
</selector>
