<?xml version="1.0" encoding="utf-8"?>
<!--
    The panel every screen's content sits in — a rounded rect a shade lighter
    than the baize window background, framed in a thin brass line. Paired with
    a small elevation set in code (Ui.Card) so it reads as raised off the felt.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/panel" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/brass" />
</shape>
