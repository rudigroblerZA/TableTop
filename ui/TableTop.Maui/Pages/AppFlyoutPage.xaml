<?xml version="1.0" encoding="utf-8" ?>
<!--
    The head's root page.

    Flyout and Detail are assigned in code-behind, not here, because both come
    from the DI container and a XAML-declared child would be constructed by the
    parser with no way to inject anything.

    FlyoutLayoutBehavior is deliberately not set, so it stays Default and MAUI
    picks per device idiom: a drawer on a phone, and a wider split where there
    is room. Pinning it to Split would give a phone a permanently visible menu
    eating a third of a screen the gameplay pages already fill; pinning it to
    Popover would waste a tablet's width. On Android, which is the target that
    matters here, Default is a drawer either way.
-->
<FlyoutPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TableTop.Maui.Pages.AppFlyoutPage" />
