<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    SafeAreaEdges="Container"
    x:Class="TableTop.Maui.Pages.MillionaireGamePage"
    Title="Millionaire"
    Background="{StaticResource StudioBrush}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding LoadError}" TextColor="#F87171" IsVisible="{Binding HasLoadError}" FontSize="15" />

            <VerticalStackLayout IsVisible="{Binding IsPlaying}" Spacing="14">
                <Label Text="{Binding PlayerName}" FontFamily="{StaticResource DisplayFont}" TextColor="{StaticResource QuizGoldBrightColor}" FontSize="18" FontAttributes="Bold" />
                <Border BackgroundColor="{StaticResource PlateColor}" Stroke="{StaticResource QuizGoldColor}" StrokeShape="RoundRectangle 10" Padding="16,10" HorizontalOptions="Center">
                    <Label Text="{Binding PrizeText}" FontFamily="{StaticResource DisplayFont}"
                           TextColor="{StaticResource QuizGoldBrightColor}" FontSize="20" FontAttributes="Bold" />
                </Border>
                <Label Text="{Binding GuaranteedText}" Style="{StaticResource PipLabelStyle}" TextColor="{StaticResource PlateEdgeColor}" HorizontalTextAlignment="Center" />

                <Border BackgroundColor="{StaticResource PlateColor}" Stroke="{StaticResource PlateEdgeColor}" StrokeShape="RoundRectangle 12" Padding="20">
                    <Label Text="{Binding QuestionText}" FontFamily="{StaticResource BodyFont}"
                           TextColor="{StaticResource TextPrimary}" FontSize="17" LineHeight="1.5"
                           HorizontalTextAlignment="Center" />
                </Border>

                <CollectionView x:Name="AnswersList" ItemsSource="{Binding Answers}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Display}" Clicked="OnAnswerClicked"
                                    Style="{StaticResource AnswerPlateStyle}"
                                    HorizontalOptions="Fill" Margin="0,5" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="LIFELINES" Style="{StaticResource PipLabelStyle}" TextColor="{StaticResource PlateEdgeColor}" Margin="0,8,0,0" />
                <CollectionView x:Name="LifelinesList" ItemsSource="{Binding Lifelines}" ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Name}" Clicked="OnLifelineClicked"
                                    IsEnabled="{Binding IsAvailable}"
                                    Style="{StaticResource LifelineStyle}" Margin="4" />
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button x:Name="WalkAwayButton" Text="Walk away" Clicked="OnWalkAwayClicked"
                        Style="{StaticResource QuietButtonStyle}" Margin="0,8,0,0" />

                <Label Text="{Binding Flash}" FontFamily="{StaticResource BodyFont}" FontAttributes="Italic" TextColor="{StaticResource QuizGoldBrightColor}" FontSize="15" Margin="0,8,0,0" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsGameOver}" Spacing="14">
                <Label Text="Final winnings" Style="{StaticResource HeaderLabelStyle}" TextColor="{StaticResource QuizGoldBrightColor}" />
                <Label Text="{Binding Summary}" TextColor="#E5E7EB" FontSize="15" LineHeight="1.5" />
                <Button x:Name="DoneButton" Text="Back to games" Clicked="OnDoneClicked"
                        Style="{StaticResource QuizButtonStyle}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
