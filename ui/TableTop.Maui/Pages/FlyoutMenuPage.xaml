<?xml version="1.0" encoding="utf-8" ?>
<!--
    The drawer itself.

    TITLE IS MANDATORY. A FlyoutPage whose Flyout has no Title throws
    InvalidOperationException the moment the page is created — on Android that
    is a startup crash, not a blank drawer. It is set here and must stay set.

    LAYOUT: a Grid with an Auto header row and a * list row, so the image keeps
    its natural height and the menu takes the rest and scrolls. A
    VerticalStackLayout would hand the CollectionView infinite height and the
    list would measure to zero — the same trap GameSelectionPage documents.
-->
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mvm="clr-namespace:TableTop.Maui.ViewModels"
    x:DataType="mvm:FlyoutMenuViewModel"
    x:Class="TableTop.Maui.Pages.FlyoutMenuPage"
    Title="TableTop"
    BackgroundColor="{StaticResource BaizeDeepColor}">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The image the flyout is topped with. AspectFill so it spans the
             drawer's width on every phone without letterboxing the felt. -->
        <Image Grid.Row="0"
               Source="flyout_header.png"
               Aspect="AspectFill"
               HeightRequest="150"
               HorizontalOptions="Fill" />

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None"
                        Margin="0,6,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mvm:FlyoutMenuItem">
                    <!-- Tap is handled on the Border, not by CollectionView
                         selection: on Android a Border inside a DataTemplate
                         consumes the touch before the CollectionView sees it,
                         so selection never fires. GameSelectionPage hit exactly
                         this and documents it. -->
                    <Border Padding="16,12"
                            Margin="8,2"
                            StrokeThickness="0"
                            BackgroundColor="Transparent">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Label Grid.Column="0"
                                   Text="{Binding Glyph}"
                                   FontSize="24"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Label Text="{Binding Detail}"
                                       FontFamily="{StaticResource BodyFont}"
                                       FontSize="12"
                                       TextColor="{StaticResource TextSecondary}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
