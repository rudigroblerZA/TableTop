<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mvm="clr-namespace:TableTop.Maui.ViewModels"
    xmlns:hosting="clr-namespace:TableTop.Hosting;assembly=TableTop.Hosting"
    x:DataType="mvm:GameSelectionViewModel"
    SafeAreaEdges="Container"
    x:Class="TableTop.Maui.Pages.GameSelectionPage"
    x:Name="SelectionPage"
    Title="TableTop"
    Background="{StaticResource BaizeBrush}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙" Order="Primary" Priority="0" Clicked="OnSettingsClicked" />
    </ContentPage.ToolbarItems>

    <!--
        LAYOUT: this is a Grid, not a VerticalStackLayout, and that matters on
        Android. A VerticalStackLayout hands its children INFINITE height, so a
        CollectionView inside one either measures to zero (the list renders
        blank) or grows past the screen with nothing able to scroll — which left
        the game list and the Start button unreachable on a phone.

        With explicit rows, each picker gets a bounded height and scrolls
        internally, and the Start button is pinned to the bottom where a thumb
        can always reach it.
    -->
    <Grid Padding="16,12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="72" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0"
               Text="TableTop"
               Style="{StaticResource HeaderLabelStyle}"
               TextColor="{StaticResource GoldBrightColor}"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,2" />

        <Label Grid.Row="1"
               Text="CHOOSE GAME TYPE"
               Style="{StaticResource PipLabelStyle}"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,4" />

        <!-- Archetypes -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Archetypes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedArchetype, Mode=TwoWay}"
                        SelectionChanged="OnArchetypeSelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="hosting:Archetype">
                    <Border Padding="14" StrokeShape="RoundRectangle 12" Stroke="#73C49E4C" BackgroundColor="#16382E" Margin="2" WidthRequest="104">
                        <!-- Tap handled explicitly: on Android the Border eats the
                             touch before the CollectionView sees it. -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnArchetypeTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding Emoji}"
                                   FontSize="30"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Name}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="3"
               Text="SELECT VARIANT"
               Style="{StaticResource PipLabelStyle}"
               HorizontalTextAlignment="Center" />

        <!-- Sub-archetypes -->
        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding SubArchetypes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedSubArchetype, Mode=TwoWay}"
                        SelectionChanged="OnSubArchetypeSelectionChanged">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="hosting:Archetype">
                    <Border Padding="14,10" StrokeShape="RoundRectangle 12" Stroke="#73C49E4C" BackgroundColor="#16382E" Margin="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubArchetypeTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="{Binding Name}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="5"
               Text="CHOOSE GAME"
               Style="{StaticResource PipLabelStyle}"
               HorizontalTextAlignment="Center" />

        <!-- Game modes: takes the remaining height and scrolls internally -->
        <CollectionView Grid.Row="6"
                        ItemsSource="{Binding GameModes}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                        SelectionChanged="OnGameModeSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mvm:GameModeItem">
                    <Border Style="{StaticResource CardStyle}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnGameModeTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Label Text="{Binding Description}"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="13"
                                   TextColor="#A9BDB4"
                                   LineHeight="1.4" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout Grid.Row="7" Spacing="8" Margin="0,10,0,0">
            <!-- Offered only when there is a session to continue, and it names
                 the table and the round so "continue" is unambiguous. Above
                 Start because a group whose phone died mid-game came back for
                 this, not for a new one. -->
            <Button Text="{Binding ResumeText}"
                    IsVisible="{Binding CanResume}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnResumeClicked" />

            <Button x:Name="StartButton"
                    Text="Start Game"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Clicked="OnStartClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
