<UserControl x:Class="TableTop.WinUI.Views.SubArchetypePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="using:TableTop.Hosting">
    <Grid Padding="36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Parent.Emoji}" FontSize="26"/>
            <TextBlock Text="{Binding Parent.Name}" FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"/>
        </StackPanel>
        <GridView Grid.Row="1" ItemsSource="{Binding Children}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="hosting:Archetype">
                    <Border Width="220" Height="140" Margin="8" CornerRadius="14"
                            Background="{StaticResource PanelBrush}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Emoji}" FontSize="34" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Button Grid.Row="2" Content="Back" Command="{Binding BackCommand}" Style="{StaticResource QuietButtonStyle}"/>
    </Grid>
</UserControl>
