<UserControl x:Class="TableTop.WinUI.Views.DayOneGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28">

            <!-- Load failure. MAUI has shown this since it was written; WinUI
                 had no path for it at all, so a mode that failed to build its
                 controller showed an empty screen with no explanation. The
                 ViewModel gained LoadError when it was shared — this surfaces it. -->
            <Border Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}"
                    Background="#33F87171" BorderBrush="#F87171" BorderThickness="1"
                    CornerRadius="8" Padding="16,12" VerticalAlignment="Top" Margin="0,0,0,12">
                <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap"
                           Foreground="#FCA5A5" FontSize="14"/>
            </Border>
        <StackPanel Spacing="16" MaxWidth="720" VerticalAlignment="Center">
            <TextBlock Text="{Binding DayLabel}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource GoldBrightBrush}"/>

            <!-- Today's card -->
            <StackPanel Spacing="16" Visibility="{Binding HasCard, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource CardStockBrush}" CornerRadius="14" Padding="22">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding CardTitle}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource CardInkBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CardText}" FontSize="16" TextWrapping="Wrap"
                                   Foreground="{StaticResource CardInkBrush}" LineHeight="26"/>
                    </StackPanel>
                </Border>
                <Button Command="{Binding CompleteTodayCommand}" Content="Mark today complete"
                        Background="{StaticResource GoldBrush}" Foreground="#1A1508" Padding="24,12"
                        HorizontalAlignment="Stretch">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Space"/>
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>

            <!-- Caught up / complete -->
            <StackPanel Spacing="16" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
                    <TextBlock Text="{Binding StatusText}" FontSize="16" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}" LineHeight="26"/>
                </Border>
                <Button Command="{Binding BackCommand}" Content="Back to games"
                        Background="{StaticResource GoldBrush}" Foreground="#1A1508" Padding="24,10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
