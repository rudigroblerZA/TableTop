<UserControl x:Class="TableTop.WinUI.Views.PlayerSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="34,28,34,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Who's playing?" Style="{StaticResource PipTextStyle}"/>
            <TextBlock Text="{Binding Mode.Name}" FontSize="27"
                       Style="{StaticResource EngravedTitleStyle}"/>

            <!-- Saved rosters — a shortcut into the fields below, not a
                 replacement for them: picking one fills Players from a
                 roster built on the Roaster screen instead of retyping
                 everyone. Hidden entirely when there's nothing saved. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0"
                        Visibility="{Binding HasSavedRosters, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding SavedRosters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Command="{Binding LoadCommand}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    ToolTipService.ToolTip="{Binding Subtitle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Add a player…" KeyDown="OnNameKeyDown"
                     FontFamily="Georgia" FontSize="15"/>
            <Button Grid.Column="1" Content="Add" Command="{Binding AddPlayerCommand}"
                    Style="{StaticResource BrassButtonStyle}"/>
        </Grid>

        <!-- Optional details: gender feeds gender-directed prompts and
             male/female-only cards; age feeds minimum-age cards. Both optional. -->
        <Grid Grid.Row="2" ColumnSpacing="10" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding GenderOptions}"
                      SelectedItem="{Binding SelectedGender, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" FontFamily="Georgia"/>
            <TextBox Grid.Column="1" Text="{Binding NewAge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Age" InputScope="Number" FontFamily="Georgia"/>
        </Grid>

        <!-- Playing as a couple: this is what unlocks couples-only cards.
             Without it the engine's CoupleOnlyRestriction can never be met. -->
        <CheckBox Grid.Row="2" IsChecked="{Binding NewIsCouple, Mode=TwoWay}"
                  Content="Playing as a couple" FontFamily="Georgia"
                  Foreground="{StaticResource TextBrush}"
                  Margin="0,54,0,0" HorizontalAlignment="Left"/>

        <!-- At the table: each player is a token with a seat -->
        <ListView Grid.Row="3" ItemsSource="{Binding Players}" Margin="0,16,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" Background="#42000000" Padding="12,10" Margin="0,4"
                            BorderBrush="#33C49E4C" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- The player's token -->
                            <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                    Background="{StaticResource BrassBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Initial}" FontFamily="Constantia"
                                           FontWeight="Bold" FontSize="14" Foreground="#22160A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="15"
                                           Style="{StaticResource EngravedTitleStyle}"/>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource PipTextStyle}"
                                           FontSize="10"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" Text="{Binding Error}" Foreground="#E5A04B" TextWrapping="Wrap"
                   FontFamily="Georgia" FontStyle="Italic"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="10" Margin="0,6,0,0"
                    VerticalAlignment="Center">
            <Button Content="Save roster" Command="{Binding SaveRosterCommand}"
                    IsEnabled="{Binding HasPlayers}" Style="{StaticResource FeltButtonStyle}"/>
            <Button Content="Clear" Command="{Binding ClearPlayersCommand}"
                    IsEnabled="{Binding HasPlayers}" Style="{StaticResource QuietButtonStyle}"/>
            <TextBlock Text="{Binding RosterStatus}" Style="{StaticResource PipTextStyle}"
                       Visibility="{Binding HasRosterStatus, Converter={StaticResource BoolToVis}}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10" Margin="0,14,0,0">
            <Button Content="Start game" Command="{Binding StartCommand}"
                    Style="{StaticResource BrassButtonStyle}"/>
            <Button Content="Back" Command="{Binding BackCommand}"
                    Style="{StaticResource QuietButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
