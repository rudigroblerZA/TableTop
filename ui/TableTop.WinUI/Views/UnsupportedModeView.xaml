<UserControl x:Class="TableTop.WinUI.Views.UnsupportedModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="440">
        <TextBlock Text="🚧" FontSize="48" HorizontalAlignment="Center"/>
        <TextBlock Text="{Binding ModeName}" FontSize="24" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>
        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextDimBrush}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
        <Button Content="Back to games" Command="{Binding GoBackCommand}"
                HorizontalAlignment="Center" Padding="24,10" Margin="0,8,0,0"
                Background="{StaticResource GoldBrush}" Foreground="#1A1508" FontWeight="SemiBold"/>
    </StackPanel>
</UserControl>
