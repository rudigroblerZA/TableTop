<UserControl x:Class="TableTop.WinUI.Views.GameSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="34,28,34,28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Choose a deck" Style="{StaticResource PipTextStyle}"/>
            <TextBlock Text="{Binding Node.Name}" FontSize="27"
                       Style="{StaticResource EngravedTitleStyle}"/>
        </StackPanel>

        <!-- Each mode sits on the shelf as a boxed deck -->
        <ListView Grid.Row="1" ItemsSource="{Binding Modes}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6" CornerRadius="10" Padding="16,14"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="#4DC49E4C" BorderThickness="1">
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding Title}" FontSize="17"
                                       Style="{StaticResource EngravedTitleStyle}"/>
                            <TextBlock Text="{Binding Description}" FontSize="13" TextWrapping="Wrap"
                                       FontFamily="Georgia" LineHeight="19"
                                       Foreground="#A9BDB4"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Grid.Row="2" Content="Back" Command="{Binding BackCommand}"
                Style="{StaticResource QuietButtonStyle}"/>
    </Grid>
</UserControl>
