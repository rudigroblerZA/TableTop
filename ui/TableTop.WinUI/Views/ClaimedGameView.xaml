<UserControl x:Class="TableTop.WinUI.Views.ClaimedGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Claimed! is a "Fun" archetype party game, not couples-specific, so it
         gets the plain board-game felt register — same as the default
         card-turn screen — rather than Monogamy's velvet or Millionaire's
         studio palette. -->
    <Grid Background="{StaticResource BaizeBrush}">

        <Border Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}"
                Background="#33F87171" BorderBrush="#F87171" BorderThickness="1"
                CornerRadius="8" Padding="16,12" VerticalAlignment="Top" Margin="0,0,0,12">
            <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap"
                       Foreground="#FCA5A5" FontSize="14"/>
        </Border>

        <Grid Padding="28,24">
            <ScrollViewer Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                <StackPanel Spacing="16" MaxWidth="700">

                    <TextBlock Text="{Binding CurrentPlayerName}" FontSize="17"
                               Style="{StaticResource EngravedTitleStyle}"
                               Foreground="{StaticResource GoldBrightBrush}"/>

                    <!-- The board: every territory, its holder, and whether the
                         current player may challenge it right now. -->
                    <Border Style="{StaticResource PanelStyle}">
                        <ItemsControl ItemsSource="{Binding Territories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource DisplayFont}" FontWeight="Bold"
                                                       FontSize="15" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Text="{Binding HolderDisplay}"
                                                       Style="{StaticResource PipTextStyle}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Challenge"
                                                Command="{Binding ChallengeCommand}"
                                                Style="{StaticResource FeltButtonStyle}" Padding="16,8"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- The drawn card, waiting for the table to judge it -->
                    <Border Background="{StaticResource CardFaceBrush}" CornerRadius="16"
                            Visibility="{Binding HasPendingChallenge, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <StackPanel Spacing="12" Margin="26,24">
                                <TextBlock Text="{Binding PendingCardTitle}"
                                           Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="{Binding PendingCardText}"
                                           Style="{StaticResource CardBodyStyle}"/>
                                <TextBlock Text="{Binding PendingDifficulty}"
                                           FontFamily="{StaticResource UtilityFont}" FontSize="12"
                                           CharacterSpacing="120" Foreground="#7C7466"/>
                                <TextBlock Text="Raid — a success steals this territory"
                                           Visibility="{Binding IsRaid, Converter={StaticResource BoolToVis}}"
                                           FontFamily="{StaticResource BodyFont}" FontStyle="Italic"
                                           Foreground="#9C6D4F"/>
                            </StackPanel>
                            <Border Margin="9" CornerRadius="10" IsHitTestVisible="False"
                                    BorderBrush="#8CC49E4C" BorderThickness="1"/>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                Visibility="{Binding HasPendingChallenge, Converter={StaticResource BoolToVis}}">
                        <Button Content="Succeeded" Command="{Binding SucceedCommand}" Padding="26,12"
                                Style="{StaticResource BrassButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Space"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                        <Button Content="Failed" Command="{Binding FailCommand}" Padding="20,12"
                                Style="{StaticResource FeltButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Escape"/>
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding Flash}" TextWrapping="Wrap"
                               FontFamily="{StaticResource BodyFont}" FontStyle="Italic"
                               Foreground="{StaticResource GoldBrightBrush}" Margin="0,6,0,0"/>

                    <Button Content="Quit" Command="{Binding BackCommand}"
                            Style="{StaticResource QuietButtonStyle}" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Results plaque -->
            <Grid Visibility="{Binding IsGameOver, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource CardFaceBrush}" CornerRadius="16"
                        MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid>
                        <StackPanel Spacing="16" Margin="34">
                            <TextBlock Text="Territory" FontSize="25"
                                       Style="{StaticResource CardTitleStyle}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource CardBodyStyle}"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Button Content="Back to games" Command="{Binding BackCommand}"
                                    HorizontalAlignment="Center" Padding="26,12"
                                    Style="{StaticResource BrassButtonStyle}"/>
                        </StackPanel>
                        <Border Margin="9" CornerRadius="10" IsHitTestVisible="False"
                                BorderBrush="#8CC49E4C" BorderThickness="1"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
