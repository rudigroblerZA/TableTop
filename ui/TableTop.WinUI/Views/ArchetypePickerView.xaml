<UserControl x:Class="TableTop.WinUI.Views.ArchetypePickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hosting="using:TableTop.Hosting">
    <Grid Padding="36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Who's playing tonight?" FontSize="27" Style="{StaticResource EngravedTitleStyle}"/>
        <GridView Grid.Row="1" ItemsSource="{Binding Archetypes}"
                  SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="hosting:Archetype">
                    <Border Width="220" Height="140" Margin="8" CornerRadius="14"
                            Background="{StaticResource PanelBrush}">
                        <StackPanel Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Emoji}" FontSize="34" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind Description}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextDimBrush}" TextAlignment="Center"
                                       Margin="10,0" MaxLines="2"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Button Grid.Row="2" Content="Back" Command="{Binding BackCommand}" Style="{StaticResource QuietButtonStyle}"/>
    </Grid>
</UserControl>
