<Solution>
  <!--
    TableTop Engine solution — engine + tests + Console. No UI *workload*
    dependencies: Console is plain net10.0 and builds anywhere the SDK does,
    unlike WinUI/MAUI/Android which need their own SDK or workload.
    Builds and tests on any OS with the .NET 10 SDK.
    Format: SLNX (XML solution) — no GUIDs, no config boilerplate.

    Console was missing here until backlog X.4, while README and CLAUDE.md both
    described this solution as "engine + tests + console". Nothing compiled it:
    CI names individual projects rather than building the solution, so the one
    head that needs no workload at all was the only one with no build coverage.
  -->

  <!-- Solution-level files -->
  <Folder Name="/Solution Items/">
    <File Path="global.json" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
  </Folder>

  <!-- Engine -->
  <Folder Name="/Engine/">
    <Project Path="src/TableTop.Core/TableTop.Core.csproj" />
    <Project Path="src/TableTop.Games/TableTop.Games.csproj" />
    <Project Path="src/TableTop.Hosting/TableTop.Hosting.csproj" />
    <Project Path="src/TableTop.Presentation/TableTop.Presentation.csproj" />
  </Folder>

  <!-- Tests -->
  <Folder Name="/Tests/">
    <Project Path="tests/TableTop.Tests/TableTop.Tests.csproj" />
  </Folder>

  <!-- UI — Console only. Needs no workload, so it belongs in the solution
       that is meant to build anywhere. -->
  <Folder Name="/UI/">
    <Project Path="ui/TableTop.Console/TableTop.Console.csproj" />
  </Folder>
</Solution>
