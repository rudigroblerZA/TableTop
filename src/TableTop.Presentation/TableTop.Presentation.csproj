<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Plain net10.0 on purpose: this project must be referenceable from BOTH
      net10.0-windows10.0.19041.0 (WinUI) and net10.0-android (MAUI), and a
      platform-flavoured TFM cannot be. Nothing in here may touch a MAUI or
      WinUI type — that constraint is the whole point, and it is what stops the
      shared ViewModels quietly re-acquiring a platform dependency.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TableTop.Hosting\TableTop.Hosting.csproj" />
  </ItemGroup>
</Project>
